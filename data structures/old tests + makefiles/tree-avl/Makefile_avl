CC = gcc
DIR_SRC = ../../lib/src
DIR_BIN = ../../lib/bin

DIR_HEAD = ../../lib/headers
DIR_FILE = .
CFLAGS = -Wall -fPIC

all: $(DIR_FILE)/tree_main.out

$(DIR_FILE)/tree_main.out: $(DIR_FILE)/tree_main.o $(DIR_BIN)/libavl.so
	$(CC) $(CFLAGS) -o $@ $<  -L$(DIR_BIN) -ltree -Wl,-rpath,$(DIR_BIN)

$(DIR_FILE)/tree_main.o: $(DIR_FILE)/tree_main.c
	$(CC) $(CFLAGS) -c $< -o $@

$(DIR_SRC)/avl.o: $(DIR_SRC)/avl.c $(DIR_HEAD)/avl.h
	$(CC) $(CFLAGS) -c $< -o $@

$(DIR_BIN)/libavl.so: $(DIR_SRC)/avl.o
	$(CC) $(CFLAGS) -shared -o $@ $^

clean: 
	rm $(DIR_FILE)/tree_main.o
	rm $(DIR_SRC)/avl.o
	rm $(DIR_BIN)/avl.so